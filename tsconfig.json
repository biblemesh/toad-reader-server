{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["jest", "node"],
    "noEmit": true
  },
  "include": ["__tests__/**/*.ts"],
  "exclude": ["node_modules", "dist", "src"]
}