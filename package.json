{
  "name": "toad-reader-server",
  "version": "1.0.0",
  "description": "Toad Reader server",
  "author": "Andy Hubert",
  "scripts": {
    "ci:build": "docker build . --target development $CACHE_ARGS --build-arg NODE_VERSION=$NODE_VERSION $DOCKER_TAGS $EXTRA_ARGS",
    "ci:lint": "npm run lint",
    "ci:test": "npm run test",
    "confirm": "read -p 'Are you sure? ' -n 1 -r && echo '\n' && [[ $REPLY =~ ^[Yy]$ ]]",
    "cron": "node ./crons/run.js",
    "cron-test": "node ./crons/test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "health-check": "node ./healthcheck.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "npx husky",
    "start": "node --expose-gc ./app.js",
    "test": "jest",
    "translate": "node node_modules/inline-i18n/scripts/makeTranslationFiles.js --parse-dirs='src' && npm run translate-convert-json-to-csv",
    "translate-convert-csv-to-json": "node node_modules/inline-i18n/scripts/convertTranslationCSVtoJSON.js",
    "translate-convert-json-to-csv": "node node_modules/inline-i18n/scripts/convertTranslationJSONtoCSV.js"
  },
  "lint-staged": {
    "*.+(json|css|md|scss|yml|yaml)": [
      "prettier --write"
    ],
    "*.+(js|jsx|ts|tsx|mjs)": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "jsonsort"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.984.0",
    "@aws-sdk/client-ses": "3.984.0",
    "@aws-sdk/cloudfront-signer": "3.978.0",
    "@node-saml/passport-saml": "^5.1.0",
    "@sentry/node": "^8.55.0",
    "@sentry/profiling-node": "^8.55.0",
    "@shopify/shopify-api": "^6.2.0",
    "adm-zip": "0.4.13",
    "array-flat-polyfill": "^1.0.1",
    "aws-ssl-profiles": "1.1.2",
    "body-parser": "1.20.3",
    "cookie-parser": "1.4.4",
    "cookie-signature": "^1.1.0",
    "cors": "2.8.5",
    "dotenv": "4.0.0",
    "expo-server-sdk": "3.5.0",
    "express": "4.22.0",
    "express-mysql-session": "^3.0.3",
    "express-session": "1.17.0",
    "html-entities": "1.2.0",
    "inline-i18n": "github:biblemesh/inline-i18n#a98d2547345ef73486f930e6b8e737b6b0c14f39",
    "jimp": "^0.22.12",
    "jsdom": "^16.4.0",
    "jsonwebtoken": "9.0.0",
    "md5": "2.2.1",
    "mime": "2.4.4",
    "minisearch": "^2.4.1",
    "moment": "2.24.0",
    "multiparty": "4.1.2",
    "music-metadata": "^7.14.0",
    "mysql2": "3.19.1",
    "node-fetch": "^2.7.0",
    "oauth-signature": "1.5.0",
    "passport": "0.5.3",
    "sqlstring": "2.3.3",
    "useragent": "^2.3.0",
    "uuid": "3.3.3",
    "ws": "^7.5.10",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "@eslint/js": "^9.21.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.27",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.0.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.5",
    "json-sort-cli": "^4.0.9",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.38.0"
  }
}
